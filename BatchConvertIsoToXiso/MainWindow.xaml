<Window x:Class="BatchConvertIsoToXiso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Convert ISO to XISO"
        Height="850" Width="1200" MinHeight="650" MinWidth="800"
        Closing="Window_Closing"
        Loaded="Window_LoadedAsync"
        KeyDown="Window_KeyDownAsync"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Header -->
            <RowDefinition Height="*" />    <!-- 1: Main Content -->
            <RowDefinition Height="Auto" /> <!-- 2: StatusBar -->
        </Grid.RowDefinitions>

        <!-- Header (RomValidator Style) -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Batch ISO to XISO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HeaderTextBrush}" VerticalAlignment="Center" Margin="0,0,30,0" ToolTip="Batch Convert ISO to XISO — Xbox preservation utility" />
                    <Button x:Name="BtnNavConvert" Content="Convert" Click="NavConvert_Click" Style="{StaticResource MenuButtonStyle}" ToolTip="Switch to the ISO to XISO batch conversion view" />
                    <Button x:Name="BtnNavTest" Content="Test Integrity" Click="NavTest_Click" Style="{StaticResource MenuButtonStyle}" ToolTip="Switch to the image integrity testing view (ISO, CSO, ZAR)" />
                    <Button x:Name="BtnNavExplorer" Content="Explorer" Click="NavExplorer_Click" Style="{StaticResource MenuButtonStyle}" ToolTip="Switch to the image file system explorer view (ISO, CSO, ZAR)" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Donate" Click="DonateButton_Click" Style="{StaticResource MenuButtonStyle}" Background="{StaticResource SecondaryAccentBrush}" ToolTip="Support the development of this application — opens the PureLogicCode donation page" />
                    <Button Content="About" Click="AboutMenuItem_Click" Style="{StaticResource MenuButtonStyle}" Background="{StaticResource AboutButtonBrush}" ToolTip="View application information" />
                    <Button Content="Exit" Click="ExitMenuItem_Click" Style="{StaticResource MenuButtonStyle}" Background="{StaticResource ExitButtonBrush}" ToolTip="Close the application" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- 0: Controls (left) + Log/Explorer (right) -->
                <RowDefinition Height="Auto" /> <!-- 1: Stats -->
                <RowDefinition Height="Auto" /> <!-- 2: Progress -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ControlsColumn" Width="*" MinWidth="400" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="10" />
                    <ColumnDefinition x:Name="LogColumn" Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Operation Controls (Styled like RomValidator Borders) -->
                <Border x:Name="ControlsBorder" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,10,0">
                    <Grid>
                    <!-- Conversion View -->
                    <Grid x:Name="ConvertView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 0: Source folder -->
                            <RowDefinition Height="Auto" /> <!-- 1: Output folder -->
                            <RowDefinition Height="Auto" /> <!-- 2: Options -->
                            <RowDefinition Height="Auto" /> <!-- 3: File list label -->
                            <RowDefinition Height="*" />    <!-- 4: File list -->
                            <RowDefinition Height="Auto" /> <!-- 5: Select buttons -->
                            <RowDefinition Height="Auto" /> <!-- 6: Start button -->
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Source Folder:" ToolTip="The folder containing ISO, ZIP, RAR, or 7z files to convert" />
                            <TextBox x:Name="ConversionInputFolderTextBox" Grid.Column="1" Style="{StaticResource CustomTextBoxStyle}" IsReadOnly="True" Margin="5,0" ToolTip="Select the folder containing ISO or archive files" />
                            <Button Grid.Column="2" Content="Browse..." Click="BrowseConversionInputButton_Click" Style="{StaticResource ActionButtonStyle}" ToolTip="Browse for source folder" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Output Folder:" ToolTip="The folder where converted files will be saved" />
                            <TextBox x:Name="ConversionOutputFolderTextBox" Grid.Column="1" Style="{StaticResource CustomTextBoxStyle}" IsReadOnly="True" Margin="5,0" ToolTip="Select the output folder for converted files" />
                            <Button Grid.Column="2" Content="Browse..." Click="BrowseConversionOutputButton_Click" Style="{StaticResource ActionButtonStyle}" ToolTip="Browse for output folder" />
                        </Grid>
                        <Expander Grid.Row="2" Header="Options" Margin="0,5,0,10" Padding="10,8" IsExpanded="True" Style="{StaticResource CustomExpanderStyle}" ToolTip="Configure conversion behavior such as file deletion, subfolder search, and integrity checking. Click the header to collapse or expand.">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4" ToolTip="Choose the output format: optimized XISO, ZAR (ZArchive/zstd), or CSO (compressed ISO)">
                                    <Label Content="Output Format:" VerticalAlignment="Center" Padding="0,0,8,0" />
                                    <RadioButton x:Name="OutputFormatXisoRadio" Content="XISO" IsChecked="True" GroupName="OutputFormat" Margin="0,0,14,0" ToolTip="Optimized XISO image (.iso) — the standard trimmed Xbox image" />
                                    <RadioButton x:Name="OutputFormatZarRadio" Content="ZAR" GroupName="OutputFormat" Margin="0,0,14,0" ToolTip="ZArchive (.zar) — zstd-compressed image, loadable in Xenia canary" />
                                    <RadioButton x:Name="OutputFormatCsoRadio" Content="CSO" GroupName="OutputFormat" ToolTip="Compressed ISO (.cso) — CISO v2 (LZ4), xdvdfs-compatible" />
                                </StackPanel>
                                <CheckBox x:Name="DeleteOriginalsCheckBox" Content="Delete original files after successful conversion" Margin="0,2,0,2" HorizontalAlignment="Left" ToolTip="Deletes the original ISO/archive if conversion is successful. Use with caution!" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="SearchSubfoldersConversionCheckBox" Content="Search for files in subfolders" Margin="0,8,0,8" HorizontalAlignment="Left" ToolTip="Include files found in subdirectories of the source folder" Style="{StaticResource CustomCheckBoxStyle}" Checked="SearchSubfoldersCheckBox_Changed" Unchecked="SearchSubfoldersCheckBox_Changed" />
                                <CheckBox x:Name="SkipSystemUpdateCheckBox" Content="Skip $SystemUpdate folder during conversion" Margin="0,2,0,2" HorizontalAlignment="Left" ToolTip="Omits the $SystemUpdate folder from the output, reducing file size" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="CheckOutputIntegrityCheckBox" Content="Check integrity of the output file" Margin="0,8,0,8" HorizontalAlignment="Left" IsChecked="True" ToolTip="Performs a structural integrity check on the converted file (for ZAR/CSO the source image is validated)" Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
                        </Expander>
                        <Label Grid.Row="3" Content="Select Files to Convert:" Margin="0,5,0,0" FontWeight="SemiBold" ToolTip="Tick the files to include in the batch conversion" />
                        <DataGrid x:Name="ConversionFilesDataGrid" Grid.Row="4" MinHeight="120" Margin="0,5" AutoGenerateColumns="False" Style="{StaticResource FileListDataGridStyle}" ToolTip="Files found in the source folder. Untick any file you do not want to convert.">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5" ToolTip="Select or deselect all files in the conversion list">
                            <Button Content="Select All" Click="SelectAllConversion_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip="Tick every file in the list" />
                            <Button Content="Deselect All" Click="DeselectAllConversion_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip="Untick every file in the list" />
                        </StackPanel>
                        <Button x:Name="StartConversionButton" Grid.Row="6" Content="Start Conversion" Style="{StaticResource StartButtonStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" Click="StartConversionButton_ClickAsync" ToolTip="Begin the batch conversion process" />
                    </Grid>

                    <!-- Test View (Hidden by default) -->
                    <Grid x:Name="TestView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 0: ISO folder -->
                            <RowDefinition Height="Auto" /> <!-- 1: Options -->
                            <RowDefinition Height="Auto" /> <!-- 2: File list label -->
                            <RowDefinition Height="*" />    <!-- 3: File list -->
                            <RowDefinition Height="Auto" /> <!-- 4: Select buttons -->
                            <RowDefinition Height="Auto" /> <!-- 5: Start button -->
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Image Folder:" ToolTip="The folder containing ISO, CSO, or ZAR files to test for structural integrity" />
                            <TextBox x:Name="TestInputFolderTextBox" Grid.Column="1" Style="{StaticResource CustomTextBoxStyle}" IsReadOnly="True" Margin="5,0" ToolTip="Select the folder containing ISO, CSO, or ZAR files to test" />
                            <Button Grid.Column="2" Content="Browse..." Click="BrowseTestInputButton_Click" Style="{StaticResource ActionButtonStyle}" ToolTip="Browse for image folder" />
                        </Grid>
                        <Expander Grid.Row="1" Header="Options" Margin="0,5,0,5" Padding="10,8" IsExpanded="True" Style="{StaticResource CustomExpanderStyle}" ToolTip="Configure integrity test behavior such as file sorting and scan depth. Click the header to collapse or expand.">
                            <StackPanel Orientation="Vertical">
                                <CheckBox x:Name="MoveSuccessFilesCheckBox" Content="Move successfully tested images to a '_success' subfolder" Margin="0,5,0,0" HorizontalAlignment="Left" IsChecked="False" ToolTip="Moves valid images to a '_success' folder within the source folder" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="MoveFailedFilesCheckBox" Content="Move failed tested images to a '_failed' subfolder" Margin="0,5,0,0" HorizontalAlignment="Left" IsChecked="False" ToolTip="Moves invalid images to a '_failed' folder within the source folder" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="SearchSubfoldersTestCheckBox" Content="Search for files in subfolders" Margin="0,5,0,0" HorizontalAlignment="Left" IsChecked="True" ToolTip="Include files found in subdirectories of the source folder" Style="{StaticResource CustomCheckBoxStyle}" Checked="SearchSubfoldersCheckBox_Changed" Unchecked="SearchSubfoldersCheckBox_Changed" />
                                <CheckBox x:Name="PerformDeepScanCheckBox" Content="Perform deep surface scan (slower)" Margin="0,5,0,5" HorizontalAlignment="Left" IsChecked="False" ToolTip="Reads the entire image (and decompresses every block for CSO/ZAR) to detect bad sectors or corrupt blocks. Unchecked performs the logical structure test only (faster)." Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
                        </Expander>
                        <Label Grid.Row="2" Content="Select Files to Test:" Margin="0,5,0,0" FontWeight="SemiBold" ToolTip="Tick the ISO, CSO, or ZAR files to include in the integrity test" />
                        <DataGrid x:Name="TestFilesDataGrid" Grid.Row="3" MinHeight="120" Margin="0,5" AutoGenerateColumns="False" Style="{StaticResource FileListDataGridStyle}" ToolTip="ISO, CSO, and ZAR files found in the folder. Untick any file you do not want to test.">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5" ToolTip="Select or deselect all files in the test list">
                            <Button Content="Select All" Click="SelectAllTest_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip="Tick every file in the list" />
                            <Button Content="Deselect All" Click="DeselectAllTest_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip="Untick every file in the list" />
                        </StackPanel>
                        <Button x:Name="StartTestButton" Grid.Row="5" Content="Start Integrity Test" Style="{StaticResource StartButtonStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" Click="StartTestButton_ClickAsync" ToolTip="Begin the batch integrity test process" />
                    </Grid>

                    <!-- Explorer View: file picker with the explorer below it -->
                    <Grid x:Name="ExplorerHeaderView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 0: File picker -->
                            <RowDefinition Height="*" />    <!-- 1: Explorer -->
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Select Image File:" ToolTip="Choose an ISO, CSO, or ZAR file to browse its internal file system" />
                            <TextBox x:Name="ExplorerFilePathTextBox" Grid.Column="1" Style="{StaticResource CustomTextBoxStyle}" IsReadOnly="True" Margin="5,0" ToolTip="Select an Xbox image to explore its contents" />
                            <Button Content="Browse..." Grid.Column="2" Click="BrowseExplorerFile_Click" Style="{StaticResource ActionButtonStyle}" ToolTip="Browse for an Xbox image" />
                        </Grid>

                        <Border x:Name="ExplorerBorder" Grid.Row="1" Margin="0,10,0,0" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="2" CornerRadius="4" Background="{StaticResource TerminalBackgroundBrush}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Navigation Bar -->
                                    <RowDefinition Height="*" />    <!-- File List -->
                                </Grid.RowDefinitions>

                                <!-- Navigation Bar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button x:Name="ExplorerUpButton" Content="⬆ Up" Click="ExplorerUpButton_Click" Width="60" Margin="0,0,10,0" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" ToolTip="Go up one directory level" />
                                    <TextBlock Text="Current Path: " VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TerminalForegroundBrush}" ToolTip="The current directory path within the image file system" />
                                    <TextBlock x:Name="ExplorerPathTextBlock" Text="/" VerticalAlignment="Center" Foreground="{StaticResource TerminalForegroundBrush}" />
                                </StackPanel>

                                <!-- File List -->
                                <ListView x:Name="ExplorerListView" Grid.Row="1" SizeChanged="ExplorerListView_SizeChanged" MouseDoubleClick="ExplorerListView_MouseDoubleClick" PreviewMouseLeftButtonDown="ExplorerListView_PreviewMouseLeftButtonDown" MouseMove="ExplorerListView_MouseMoveAsync" BorderThickness="0" Background="{StaticResource TerminalBackgroundBrush}" ItemContainerStyle="{StaticResource ExplorerListViewItemStyle}" ToolTip="Double-click directories to navigate, double-click files to extract. Drag and drop files to copy them out of the image.">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource ExplorerGridViewColumnHeaderStyle}">
                                            <GridViewColumn x:Name="ExplorerNameColumn">
                                                <GridViewColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="Name" Foreground="{StaticResource TerminalForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Left" Padding="10,5" />
                                                    </DataTemplate>
                                                </GridViewColumn.HeaderTemplate>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding IsDirectory, Converter={StaticResource FolderIconConverter}}" Margin="0,0,5,0" Foreground="{StaticResource TerminalForegroundBrush}" />
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TerminalForegroundBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="ExplorerSizeColumn" Width="120">
                                                <GridViewColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="Size" Foreground="{StaticResource TerminalForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Left" Padding="10,5" />
                                                    </DataTemplate>
                                                </GridViewColumn.HeaderTemplate>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SizeFormatted}" Foreground="{StaticResource TerminalForegroundBrush}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="ExplorerTypeColumn" Width="100">
                                                <GridViewColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="Type" Foreground="{StaticResource TerminalForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Left" Padding="10,5" />
                                                    </DataTemplate>
                                                </GridViewColumn.HeaderTemplate>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource TerminalForegroundBrush}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                </Border>

                <!-- Splitter between the controls and the log -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the panels" />

                <!-- 1. Log Content -->
                <Border x:Name="LogBorder" Grid.Column="2" Margin="10,0,0,0" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="2" CornerRadius="4" Background="{StaticResource TerminalBackgroundBrush}">
                     <TextBox x:Name="LogViewer"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontFamily="{StaticResource TerminalFontFamily}"
                             FontSize="13"
                             Background="{StaticResource TerminalBackgroundBrush}"
                             Foreground="{StaticResource TerminalForegroundBrush}"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="8"
                             CaretBrush="{StaticResource TerminalForegroundBrush}"
                             ToolTip="Displays real-time conversion, testing, and general operation output logs">
                        <TextBox.Effect>
                            <DropShadowEffect ShadowDepth="0" Color="#39FF14" BlurRadius="2" Opacity="0.4"/>
                        </TextBox.Effect>
                    </TextBox>
                </Border>
            </Grid>

            <!-- 2. Stats Panel -->
            <Grid x:Name="StatsPanel" Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Total number of files processed in the current batch operation">
                    <StackPanel>
                        <TextBlock Text="Total Files:" Style="{StaticResource StatsLabelStyle}"/>
                        <TextBlock x:Name="TotalFilesValue" Text="0" Style="{StaticResource StatsValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Number of files that completed successfully">
                    <StackPanel>
                        <TextBlock Text="Success:" Style="{StaticResource StatsLabelStyle}" Foreground="{StaticResource SuccessTextBrush}"/>
                        <TextBlock x:Name="SuccessValue" Text="0" Style="{StaticResource StatsValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Number of files that failed processing">
                    <StackPanel>
                        <TextBlock Text="Failed:" Style="{StaticResource StatsLabelStyle}" Foreground="{StaticResource FailedTextBrush}"/>
                        <TextBlock x:Name="FailedValue" Text="0" Style="{StaticResource StatsValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Number of files that were skipped (e.g., already converted or incompatible)">
                    <StackPanel>
                        <TextBlock Text="Skipped:" Style="{StaticResource StatsLabelStyle}" Foreground="{StaticResource SkippedTextBrush}"/>
                        <TextBlock x:Name="SkippedValue" Text="0" Style="{StaticResource StatsValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Total elapsed processing time for the current batch operation">
                    <StackPanel>
                        <TextBlock Text="Time:" Style="{StaticResource StatsLabelStyle}"/>
                        <TextBlock x:Name="ProcessingTimeValue" Text="00:00:00" Style="{StaticResource StatsValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Current read speed of the active operation">
                    <StackPanel>
                        <TextBlock Text="Read Speed:" Style="{StaticResource StatsLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ReadSpeedValue" Text="N/A" Style="{StaticResource StatsValueStyle}"/>
                            <TextBlock x:Name="ReadSpeedDriveIndicator" Text="" Margin="5,0,0,0" Style="{StaticResource StatsValueStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource StatsCardBorderStyle}" ToolTip="Current write speed of the active operation">
                    <StackPanel>
                        <TextBlock Text="Write Speed:" Style="{StaticResource StatsLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="WriteSpeedValue" Text="N/A" Style="{StaticResource StatsValueStyle}"/>
                            <TextBlock x:Name="WriteSpeedDriveIndicator" Text="" Margin="5,0,0,0" Style="{StaticResource StatsValueStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Progress Area -->
            <Grid x:Name="ProgressAreaGrid" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1" Background="{StaticResource CardBackgroundBrush}">
                    <Grid>
                        <ProgressBar x:Name="ProgressBar" Height="24" Foreground="{StaticResource ProgressForegroundBrush}" Background="{StaticResource ProgressBackgroundBrush}" BorderThickness="0" ToolTip="Progress of the current batch operation" />
                        <TextBlock x:Name="ProgressTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="Current operation progress percentage and file name" />
                    </Grid>
                </Border>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Style="{StaticResource CancelButtonStyle}" Margin="10,0,0,0" Visibility="Collapsed" Click="CancelButton_Click" ToolTip="Cancel the current operation" />
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBackgroundBrush}" Padding="5">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Ready." ToolTip="Displays current application status and messages" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="MemoryTextBlock" Text="Memory: 0 MB" FontSize="11" ToolTip="Current application memory usage" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>