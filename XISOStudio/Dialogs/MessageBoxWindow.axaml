<Window x:Class="XISOStudio.Dialogs.MessageBoxWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        Icon="avares://XISOStudio/icon/icon.png"
        SizeToContent="Height"
        MinHeight="160"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ToolTip.Tip="Message box">
    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10"
            Padding="18"
            ToolTip.Tip="Message box content">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{StaticResource HeaderTextBrush}"
                       TextWrapping="Wrap"
                       ToolTip.Tip="Title of this message"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,16"
                        ToolTip.Tip="Icon and message describing the situation">
                <TextBlock x:Name="IconText"
                           FontSize="22"
                           Margin="0,0,12,0"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource InfoTextBrush}"
                           ToolTip.Tip="Severity icon: information, warning, or error"/>
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           MaxWidth="370"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           ToolTip.Tip="Message describing the situation"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        ToolTip.Tip="Available responses">
                <Button x:Name="YesButton" Content="Yes" Click="YesButton_Click" Theme="{StaticResource ActionButtonStyle}" MinWidth="80"
                        ToolTip.Tip="Confirm and continue"/>
                <Button x:Name="NoButton" Content="No" Click="NoButton_Click" Theme="{StaticResource ActionButtonStyle}" MinWidth="80"
                        ToolTip.Tip="Decline and continue"/>
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Theme="{StaticResource CancelButtonStyle}" MinWidth="80"
                        ToolTip.Tip="Stop the current operation without deciding"/>
                <Button x:Name="OkButton" Content="OK" Click="OkButton_Click" Theme="{StaticResource ActionButtonStyle}" MinWidth="80"
                        ToolTip.Tip="Acknowledge this message and close the dialog"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
